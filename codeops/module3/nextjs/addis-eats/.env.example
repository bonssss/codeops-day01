# ========================================================
# Addis Eats — Environment Configuration Template
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# DO NOT commit real secrets or credentials to source control.
# ========================================================

# Application Configuration
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_NAME="Addis Eats"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# API & Telemetry Configuration
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000/api"
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-DEMO12345"

# Delivery & Regional Settings
NEXT_PUBLIC_DEFAULT_CITY="Addis Ababa"
NEXT_PUBLIC_CURRENCY_SYMBOL="ETB"
NEXT_PUBLIC_DEFAULT_DELIVERY_FEE=2.50

# Simulated Payment Gateways (Telebirr, CBE Birr)
TELEBIRR_APP_ID="demo-telebirr-app-id"
TELEBIRR_APP_KEY="demo-telebirr-app-key"
TELEBIRR_SHORT_CODE="123456"

# Session & Security Secret
SESSION_SECRET="replace-with-a-secure-random-32-character-secret"
